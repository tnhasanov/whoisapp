# PersonBrief configuration. Copy to .env.local (development) or .env (Docker)
# and replace every placeholder. Never commit real values.

# --- Docker Compose only ---------------------------------------------------
# Password for the bundled PostgreSQL service; DATABASE_URL is derived from it.
POSTGRES_PASSWORD=CHANGE_ME

# --- Required ---------------------------------------------------------------
# PostgreSQL connection string (PostgreSQL 14 or newer).
DATABASE_URL=postgres://personbrief:CHANGE_ME@localhost:5432/personbrief
# Session signing secret, at least 32 random characters (e.g. `openssl rand -base64 48`).
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Public URL of the app, used for absolute links (PDF source links, sign-in).
APP_URL=http://localhost:3000

# --- Owner account ----------------------------------------------------------
# Optional one-time token that enables the /setup page while no owner exists.
# Leave empty to create the owner from the command line instead:
#   OWNER_PASSWORD='…' npm run owner:create -- --email you@example.com --name "Your Name"
OWNER_SETUP_TOKEN=

# --- Demo -------------------------------------------------------------------
# Lets visitors open a temporary, clearly fictional demo workspace without an
# account. It never has access to live research.
PUBLIC_DEMO_ENABLED=false
# Hours before temporary demo guests and their fictional data are deleted.
DEMO_GUEST_TTL_HOURS=24
# Simulated provider latency for the fictional demo, per call (milliseconds).
FIXTURE_LATENCY_MS=350

# --- Live research providers (both required for live research) -------------
# Tavily search and extraction: https://app.tavily.com
TAVILY_API_KEY=
# Anthropic API: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# default | off — server-side fallback when a request is declined.
ANTHROPIC_FALLBACKS=default
# Optional API base URL override for an approved gateway. Leave empty for api.anthropic.com.
ANTHROPIC_API_URL=

# --- Research budgets (hard caps; the owner can only lower them) -----------
RESEARCH_MAX_SEARCH_QUERIES=16
RESEARCH_MAX_RESULTS_PER_QUERY=6
RESEARCH_MAX_EXTRACT_PAGES=12
RESEARCH_MAX_MODEL_CALLS=10
RESEARCH_MAX_OUTPUT_TOKENS=16000
RESEARCH_MAX_SOURCE_CHARS=24000
RESEARCH_PROVIDER_TIMEOUT_MS=45000
RESEARCH_PROVIDER_MAX_RETRIES=2
RESEARCH_MAX_JOBS_PER_HOUR=20
# Direct page reading outside the providers (SSRF-protected). Off by default.
DIRECT_FETCH_ENABLED=false

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=90
WORKER_POLL_MS=1500
JOB_MAX_ATTEMPTS=3

# --- Retention --------------------------------------------------------------
# Days to keep retrieved page text (excerpts in briefs are kept until deletion).
SOURCE_CONTENT_RETENTION_DAYS=14
# Hours to reuse identical provider responses (per owner).
PROVIDER_CACHE_TTL_HOURS=72

# --- Optional ---------------------------------------------------------------
# Extra origins trusted by the auth layer, comma-separated (e.g. a second hostname).
TRUSTED_ORIGINS=
# Enable sign-in rate limiting outside production (always on in production).
AUTH_RATE_LIMIT=

# --- Tests only -------------------------------------------------------------
# Integration tests TRUNCATE this database. Never point it at real data.
TEST_DATABASE_URL=postgres://personbrief:CHANGE_ME@localhost:5432/personbrief_test
# End-to-end tests reset research data in this database.
E2E_DATABASE_URL=postgres://personbrief:CHANGE_ME@localhost:5432/personbrief_e2e
