# Copy to .env.local for local development. EXPO_PUBLIC_* values are compiled
# into the app bundle: never put secrets here.

# PersonBrief server. Leave empty in development to use the computer that runs
# Metro (http://<your-computer's-LAN-IP>:3000). A phone cannot reach the
# computer through "localhost". Preview and production builds require https://.
EXPO_PUBLIC_API_URL=

# Build variant: development | preview | production (EAS sets this per profile).
APP_VARIANT=development

# Set after `eas init` (needed for EAS builds and push notifications).
EAS_PROJECT_ID=
EXPO_OWNER=
