{
  "name": "personbrief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev\" \"npm:worker:dev\"",
    "dev:web": "next dev",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch --clear-screen=false src/worker/index.ts",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "start:all": "concurrently -k -n web,worker \"next start -H 0.0.0.0\" \"npm:worker\"",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "tsx scripts/migrate.ts --test",
    "owner:create": "tsx scripts/create-owner.ts",
    "fixtures:check": "tsx scripts/check-fixtures.ts",
    "e2e:serve": "concurrently -k -n web,worker \"next start -p 3100\" \"npm:worker\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tavily/core": "^0.7.13",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "drizzle-orm": "^0.45.3",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-intl": "^4.14.8",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/source-serif-4": "^0.4.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
